---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhyUs from '../components/WhyUs.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Destinations from '../components/Destinations.astro';
import Fleet from '../components/Fleet.astro';
import MoreServices from '../components/MoreServices.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import BookingModal from '../components/BookingModal.astro';
import BookingForm from '../components/BookingForm.astro';
---

<BaseLayout locale="fr" routeKey="home">
  <Hero locale="fr" />
  <WhyUs locale="fr" />
  <HowItWorks locale="fr" />
  <Destinations locale="fr" />
  <Fleet locale="fr" />
  <MoreServices locale="fr" />
  <Reviews locale="fr" />
  <FAQ locale="fr" />
  <FinalCTA locale="fr" />

  {/* BookingForm lives INSIDE the modal — opens on any "Réserver" CTA,
      closed by default, closes on Esc / backdrop / X. Form logic unchanged. */}
  <BookingModal locale="fr">
    <BookingForm locale="fr" />
  </BookingModal>
</BaseLayout>
