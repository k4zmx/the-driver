---
import { t } from '../i18n';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const s = t(locale).moreServices;

const WA_NUMBER = '33628658127';

const services = [
  {
    id: 'hourly',
    data: s.hourly,
    waHref: `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(s.hourly.whatsappMessage)}`,
  },
  {
    id: 'long-distance',
    data: s.longDistance,
    waHref: `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(s.longDistance.whatsappMessage)}`,
  },
];
---

<section class="ms section-y" aria-labelledby="ms-heading">
  <div class="ms-top-accent" aria-hidden="true"></div>

  <div class="page-x mx-auto max-w-[1200px]">
    <header class="max-w-[640px]" data-reveal>
      <p class="ms-eyebrow">{s.eyebrow}</p>
      <h2 id="ms-heading" class="h2 text-balance ms-heading">{s.heading}</h2>
    </header>

    <div class="ms-grid mt-12 md:mt-16">
      {services.map((svc, i) => (
        <article
          id={svc.id}
          class="ms-card"
          data-reveal
          data-reveal-delay={String(i + 1)}
        >
          <span class="ms-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="ms-head">
            <p class="ms-card-eyebrow">{svc.data.eyebrow}</p>
            <h3 class="ms-title">{svc.data.title}</h3>
          </div>

          <p class="ms-price">{svc.data.price}</p>

          <p class="ms-body">{svc.data.body}</p>

          <ul class="ms-bullets">
            {svc.data.bullets.map((b: string) => (
              <li class="ms-bullet">
                <svg class="ms-bullet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <a
            href={svc.waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="ms-cta"
            data-press
          >
            <svg class="ms-cta-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>{svc.data.cta}</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ms {
    position: relative;
    background: var(--color-night);
    color: var(--color-cream);
    isolation: isolate;
    overflow: hidden;
  }
  .ms::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at 85% 0%,
        color-mix(in oklab, var(--color-accent) 10%, transparent) 0%,
        transparent 55%
      ),
      radial-gradient(
        ellipse at 15% 100%,
        color-mix(in oklab, var(--color-accent) 6%, transparent) 0%,
        transparent 55%
      );
    pointer-events: none;
    z-index: 0;
  }
  .ms > * {
    position: relative;
    z-index: 1;
  }

  .ms-top-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in oklab, var(--color-accent) 45%, transparent),
      transparent
    );
    z-index: 2;
  }

  .ms-eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 14px;
  }
  .ms-heading {
    color: var(--color-cream);
  }

  .ms-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 0;
  }
  @media (min-width: 768px) {
    .ms-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
  }

  .ms-card {
    position: relative;
    padding: 32px 28px 28px;
    border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--color-cream) 5%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-cream) 10%, transparent);
    display: flex;
    flex-direction: column;
    transition: background-color 260ms var(--ease-out), border-color 260ms var(--ease-out), transform 260ms var(--ease-out);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .ms-card { padding: 40px 36px 36px; }
  }
  @media (hover: hover) {
    .ms-card:hover {
      background: color-mix(in oklab, var(--color-cream) 9%, transparent);
      border-color: color-mix(in oklab, var(--color-accent) 35%, transparent);
      transform: translateY(-2px);
    }
  }

  .ms-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--color-accent) 85%, transparent);
    margin-bottom: 18px;
  }

  .ms-head { display: block; }
  .ms-card-eyebrow {
    font-size: 11px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
    margin: 0 0 8px;
  }
  .ms-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-cream);
    margin: 0;
  }
  @media (min-width: 768px) {
    .ms-title { font-size: 32px; }
  }

  .ms-price {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 768px) {
    .ms-price { font-size: 48px; }
  }

  .ms-body {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-cream) 72%, transparent);
  }
  @media (min-width: 768px) {
    .ms-body { font-size: 16px; }
  }

  .ms-bullets {
    margin-top: 18px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ms-bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-cream) 85%, transparent);
  }
  .ms-bullet-icon {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
    margin-top: 3px;
    flex-shrink: 0;
  }

  /* CTA — accent-filled WhatsApp button, full-width mobile, inline desktop */
  .ms-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding: 0 22px;
    margin-top: 28px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    align-self: stretch;
    box-shadow:
      0 10px 26px -10px color-mix(in oklab, var(--color-accent) 80%, transparent),
      0 0 0 1px color-mix(in oklab, white 10%, transparent) inset;
    transition:
      background-color 220ms var(--ease-out),
      box-shadow 260ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  @media (min-width: 768px) {
    .ms-cta { align-self: flex-start; }
  }
  .ms-cta:hover {
    background: var(--color-accent-ink);
    box-shadow:
      0 14px 34px -10px color-mix(in oklab, var(--color-accent) 85%, transparent),
      0 0 0 1px color-mix(in oklab, white 14%, transparent) inset;
  }
  .ms-cta:active { transform: scale(0.98); }
  .ms-cta-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
</style>
