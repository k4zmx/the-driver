---
import { t } from '../i18n';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const nudge = t(locale).pages.faqContact.nudge;
const waHref = `https://wa.me/33634301292?text=${encodeURIComponent(t(locale).pages.faqContact.cards.whatsapp.whatsappMessage)}`;
---

<section class="cnudge" aria-label="WhatsApp">
  <div class="cnudge-top-accent" aria-hidden="true"></div>
  <div class="cnudge-bg" aria-hidden="true"><div class="cnudge-glow"></div></div>

  <div class="cnudge-inner page-x mx-auto max-w-[640px] text-center">
    <p class="cnudge-body" data-reveal>{nudge.body}</p>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="cnudge-cta"
      data-press
      data-reveal
      data-reveal-delay="1"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="cnudge-cta-icon">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      <span>{nudge.cta}</span>
    </a>
  </div>
</section>

<style>
  .cnudge {
    position: relative;
    background: var(--color-night);
    color: var(--color-cream);
    isolation: isolate;
    overflow: hidden;
    padding-top: 60px;
    padding-bottom: 64px;
  }
  @media (min-width: 768px) {
    .cnudge { padding-top: 80px; padding-bottom: 88px; }
  }

  .cnudge-top-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      to right, transparent,
      color-mix(in oklab, var(--color-accent) 45%, transparent),
      transparent
    );
    z-index: 2;
  }
  .cnudge-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .cnudge-glow {
    position: absolute;
    top: 50%; left: 50%;
    width: 700px; height: 700px;
    margin: -350px 0 0 -350px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-accent) 20%, transparent) 0%,
      transparent 60%
    );
    filter: blur(70px);
    opacity: 0.7;
  }

  .cnudge-inner { position: relative; z-index: 1; }

  .cnudge-body {
    margin: 0 auto;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--color-cream);
    max-width: 28ch;
  }
  @media (min-width: 768px) {
    .cnudge-body { font-size: 30px; }
  }

  .cnudge-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    height: 56px;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    box-shadow:
      0 14px 34px -10px color-mix(in oklab, var(--color-accent) 75%, transparent),
      0 0 0 1px color-mix(in oklab, white 12%, transparent) inset;
    transition:
      background-color 220ms var(--ease-out),
      box-shadow 260ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .cnudge-cta:hover {
    background: var(--color-accent-ink);
  }
  .cnudge-cta:active { transform: scale(0.98); }
  .cnudge-cta-icon { width: 18px; height: 18px; }
</style>
