---
import { t } from '../i18n';
import { PRICES } from '../data/routes.js';
import Icon from './Icon.astro';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const s = t(locale).pages.fleet.groups;

// Sample prices for the 4 fixed-tier combo cards — pulled from the
// canonical route matrix so the cards stay in sync if the client tweaks
// numbers in routes.js. Using CDG → Paris as the headline reference
// route: it's the most-booked airport-to-city pair, so the price the
// reader sees here will match what they'll see in the booking form.
const refRoute = PRICES['CDG']['Paris'];
const samplePrices: Record<string, string> = {
  '12': `€${refRoute.p12}`,
  '16': `€${refRoute.p16}`,
  '20': `€${refRoute.p20}`,
  '24': `€${refRoute.p24}`,
};

// Parse combo text to decide silhouette icons (bus for van, car for sedan).
// Works across all 4 locales — matches the substring markers used in
// translations. `sed[aá]n` covers EN "sedan" + ES "sedán" (with accent).
const iconsForCombo = (comboText: string): string[] => {
  const lc = comboText.toLowerCase();
  const result: string[] = [];
  const vans = (lc.match(/\bvan[io]?s?|furgon|furgone/g) ?? []).length;
  const cars = (lc.match(/berlin|sed[aá]n/g) ?? []).length;
  for (let i = 0; i < vans; i++) result.push('bus-silhouette');
  for (let i = 0; i < cars; i++) result.push('car-silhouette');
  return result;
};
---

<section class="gc section-y" aria-labelledby="gc-heading">
  <div class="gc-top-accent" aria-hidden="true"></div>
  <div class="gc-bg" aria-hidden="true">
    <div class="gc-glow"></div>
  </div>

  <div class="page-x mx-auto max-w-[1100px] relative">
    <header class="gc-head" data-reveal>
      <div class="gc-badge" aria-hidden="true">
        <span>9+</span>
      </div>
      <div>
        <p class="gc-eyebrow">{s.eyebrow}</p>
        <h2 id="gc-heading" class="gc-heading text-balance">{s.heading}</h2>
        <p class="gc-sub">{s.sub}</p>
      </div>
    </header>

    <ul class="gc-grid mt-10 md:mt-12">
      {s.combos.map((combo: { pax: string; label: string; combo: string }, i: number) => {
        const icons = iconsForCombo(combo.combo);
        const price = samplePrices[combo.pax] ?? '';
        return (
          <li
            class="gc-card"
            data-reveal
            data-reveal-delay={String(i + 1)}
          >
            <p class="gc-card-pax tabular-nums">{combo.pax}</p>
            <p class="gc-card-label">{combo.label}</p>
            <div class="gc-card-sep" aria-hidden="true"></div>
            <div class="gc-card-silhouettes" aria-hidden="true">
              {icons.map((iconName) => (
                <Icon name={iconName} size={22} strokeWidth={1.2} />
              ))}
            </div>
            <p class="gc-card-combo">{combo.combo}</p>
            {price && <p class="gc-card-price tabular-nums">{price}</p>}
          </li>
        );
      })}
    </ul>

    <p class="gc-foot" data-reveal data-reveal-delay="4">{s.footer}</p>
  </div>
</section>

<style>
  .gc {
    position: relative;
    background: var(--color-night);
    color: var(--color-cream);
    isolation: isolate;
    overflow: hidden;
  }
  .gc-top-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in oklab, var(--color-accent) 45%, transparent),
      transparent
    );
    z-index: 2;
  }
  .gc-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .gc-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    width: 900px;
    height: 500px;
    margin-left: -450px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--color-accent) 15%, transparent) 0%,
      transparent 60%
    );
    filter: blur(90px);
    opacity: 0.8;
  }

  .gc-head {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .gc-head { gap: 28px; align-items: center; }
  }

  .gc-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px; height: 64px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1;
    box-shadow:
      0 16px 40px -12px color-mix(in oklab, var(--color-accent) 80%, transparent),
      0 0 0 1px color-mix(in oklab, white 12%, transparent) inset;
  }
  @media (min-width: 768px) {
    .gc-badge { width: 72px; height: 72px; font-size: 26px; }
  }

  .gc-eyebrow {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-accent);
  }
  .gc-heading {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-cream);
  }
  @media (min-width: 768px) {
    .gc-heading { font-size: 40px; }
  }
  .gc-sub {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-cream) 72%, transparent);
    max-width: 56ch;
  }

  .gc-grid {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  /* 1 → 2 → 4 column ladder: 4 cards (12/16/20/24) lay out evenly on
     wide desktops and as 2×2 on tablet, instead of an awkward 3+1 with
     an orphan card on a 3-column grid. */
  @media (min-width: 640px) {
    .gc-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media (min-width: 1024px) {
    .gc-grid { grid-template-columns: repeat(4, 1fr); gap: 18px; }
  }

  .gc-card {
    position: relative;
    padding: 22px 22px 24px;
    border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--color-cream) 5%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-cream) 10%, transparent);
    transition: background-color 260ms var(--ease-out), border-color 260ms var(--ease-out), transform 260ms var(--ease-out);
  }
  @media (hover: hover) {
    .gc-card:hover {
      background: color-mix(in oklab, var(--color-cream) 9%, transparent);
      border-color: color-mix(in oklab, var(--color-accent) 35%, transparent);
      transform: translateY(-2px);
    }
  }
  .gc-card-pax {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 40px;
    line-height: 1;
    color: var(--color-cream);
  }
  .gc-card-label {
    margin: 6px 0 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
  }
  .gc-card-sep {
    margin: 16px 0;
    height: 1px;
    background: color-mix(in oklab, var(--color-cream) 12%, transparent);
  }
  .gc-card-silhouettes {
    display: flex;
    gap: 6px;
    color: color-mix(in oklab, var(--color-cream) 65%, transparent);
  }
  .gc-card-combo {
    margin: 10px 0 0;
    font-size: 14px;
    color: color-mix(in oklab, var(--color-cream) 82%, transparent);
  }
  .gc-card-price {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1;
    color: var(--color-cream);
  }

  .gc-foot {
    position: relative;
    z-index: 1;
    margin: 24px auto 0;
    max-width: 56ch;
    text-align: center;
    font-size: 14px;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-cream) 60%, transparent);
  }
</style>
