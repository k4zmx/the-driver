     before the text. Decorative; the text itself is the source of truth
     for screen readers (icons are aria-hidden). */
  .bf-vehicle-cell {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: wrap;
    text-align: right;
  }
  .bf-vehicle-icons {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-graphite);
    flex-shrink: 0;
  }
  .bf-vehicle-icons:empty { display: none; }
  .bf-vehicle-icons svg {
    width: 18px;
    height: 18px;
    display: block;
  }
</style>
