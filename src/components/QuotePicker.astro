---
import { PICKUP_POINTS, DROP_POINTS, PRICES } from '../data/routes.js';
import { t } from '../i18n';
import LocationPicker from './LocationPicker.astro';
import { minCarStarting } from '../utils/pricing.js';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
  /** Optional visual variant — 'hero' gets bigger price, 'compact' smaller. */
  variant?: 'hero' | 'compact';
  /**
   * Where the submit button should go.
   * - Same-page: leave default '#booking-form' (script smooth-scrolls to it).
   * - Different page: pass an absolute path like '/#booking-form' (FR) or '/en/#booking-form'.
   *   The form GET-submits naturally; the destination page reads the query params and prefills.
   */
  targetHref?: string;
}

const { locale, variant = 'hero', targetHref = '#booking-form' } = Astro.props;
const strings = t(locale);
const hero = strings.hero;

// Idle-state teaser — shows the floor price across the matrix until the user
// has picked both endpoints. Anchors price expectations on first glance.
const teaserMin = minCarStarting() ?? 45;

// Conversion microcopy beneath the CTA. Locale-aware reassurance pulled from
// existing form strings where applicable, with hero-specific tweaks.
const availableLabel =
  locale === 'en' ? 'Available now · Reply within 1h'
  : locale === 'es' ? 'Disponible ahora · Respuesta en 1h'
  : locale === 'it' ? 'Disponibile ora · Risposta entro 1h'
  : 'Disponible maintenant · Réponse en 1h';

const reassureLabel =
  locale === 'en' ? 'No deposit · WhatsApp confirmation in 1h'
  : locale === 'es' ? 'Sin depósito · Confirmación por WhatsApp en 1h'
  : locale === 'it' ? 'Nessun acconto · Conferma WhatsApp entro 1h'
  : 'Aucun acompte · Confirmation WhatsApp en 1h';

const teaserLabel =
  locale === 'en' ? 'Trips from'
  : locale === 'es' ? 'Trayectos desde'
  : locale === 'it' ? 'Tratte da'
  : 'Trajets dès';

// Serialise prices + strings for the inline script (no external fetch).
const dataBlob = {
  prices: PRICES,
  labels: {
    from: hero.price.from,
    empty: hero.price.empty,
    unavailable: hero.price.unavailable,
  },
};

const uid = 'qp-' + Math.random().toString(36).slice(2, 9);
---

<div class="qp-shell" data-variant={variant}>
  {/* Live availability badge — pulsing dot + reassurance. Floats just
      above the booking card to anchor "this is bookable RIGHT NOW". */}
  {variant === 'hero' && (
    <div class="qp-live" aria-live="polite">
      <span class="qp-live-dot" aria-hidden="true"></span>
      <span class="qp-live-label">{availableLabel}</span>
    </div>
  )}

  <form
    class:list={[
      'quote-picker relative bg-[color:var(--color-paper)] flex flex-col gap-3',
      variant === 'hero' ? 'qp-card qp-card--hero' : 'qp-card qp-card--compact',
    ]}
    action={targetHref}
    method="get"
    data-quote-picker
    data-picker-id={uid}
    novalidate
  >
    {/* Animated accent gradient border — a thin glowing rim that slowly
        rotates around the card. Pure CSS, GPU-only. */}
    {variant === 'hero' && <span class="qp-rim" aria-hidden="true"></span>}

    <script is:inline type="application/json" data-picker-data={uid} set:html={JSON.stringify(dataBlob)} />

  {/* Pickup — custom combobox (hidden native select inside drives form state).
      Mobile: bottom sheet with backdrop + drag-to-close (default variant). */}
  <LocationPicker
    uid={`${uid}-pickup`}
    name="pickup"
    dataRole="pickup"
    label={hero.pickup.label}
    placeholder={hero.pickup.placeholder}
    options={PICKUP_POINTS}
    iconType="from"
    mobileVariant="sheet"
  />

  {/* Connector — soft dashed line with centered arrow dot */}
  <div class="qp-connector" aria-hidden="true">
    <span class="qp-connector-line"></span>
    <span class="qp-connector-dot">
      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <polyline points="19 12 12 19 5 12"/>
      </svg>
    </span>
    <span class="qp-connector-line"></span>
  </div>

  {/* Drop-off */}
  <LocationPicker
    uid={`${uid}-dropoff`}
    name="dropoff"
    dataRole="dropoff"
    label={hero.dropoff.label}
    placeholder={hero.dropoff.placeholder}
    options={DROP_POINTS}
    iconType="to"
    mobileVariant="sheet"
  />

    {/* Divider + price block. Idle state shows a "Trips from €X" teaser
        so users see prices are reasonable before they commit. When both
        pickers are filled, the price block lights up with an accent glow. */}
    <div class="qp-price-block" data-role="price-block">
      <div class="qp-price-meta">
        <span class="qp-price-label" data-role="price-label">{teaserLabel}</span>
      </div>
      <div
        class:list={[
          'qp-price font-display font-medium tracking-[-0.02em] text-[color:var(--color-ink)] leading-none tabular-nums',
          variant === 'hero' ? 'text-[44px] md:text-[52px] lg:text-[60px]' : 'text-[34px]',
        ]}
        data-role="price-display"
        aria-live="polite"
      >€{teaserMin}</div>
    </div>

    {/* CTA — pulsing accent ring once the user has filled both pickers
        signals "ready to book" and pulls the eye. */}
    <button
      type="submit"
      class="btn-primary qp-cta w-full mt-1"
      data-role="submit"
      data-press
      data-magnetic
      data-magnetic-strength="0.25"
      aria-disabled="true"
      disabled
    >
      <span class="qp-cta-pulse" aria-hidden="true"></span>
      <span class="qp-cta-label">{hero.cta}</span>
      <svg
        class="qp-cta-arrow h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </button>

    {/* Risk-reversal microcopy — reassurance directly under the CTA */}
    {variant === 'hero' && (
      <p class="qp-reassure">
        <svg class="qp-reassure-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>{reassureLabel}</span>
      </p>
    )}
  </form>
</div>

<style>
  /* ---------------------------------------------------------------
     Outer shell — provides the position context for the live badge
     and the rotating gradient rim around the card.
     --------------------------------------------------------------- */
  .qp-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Live availability badge — green pulse + "Available · Reply within 1h".
     Sits on top of the card's upper edge for "alive right now" signaling. */
  .qp-live {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--color-paper);
    border: 1px solid color-mix(in oklab, var(--color-success, #1B9F4A) 30%, var(--color-smoke));
    box-shadow: 0 4px 14px -6px rgba(26, 26, 26, 0.10);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    margin-bottom: 4px;
  }
  .qp-live-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-success, #1B9F4A);
    flex-shrink: 0;
  }
  .qp-live-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background: var(--color-success, #1B9F4A);
    opacity: 0.4;
    animation: qp-live-pulse 1.6s ease-out infinite;
  }
  @keyframes qp-live-pulse {
    0%   { transform: scale(0.6); opacity: 0.55; }
    100% { transform: scale(1.9); opacity: 0;    }
  }
  @media (prefers-reduced-motion: reduce) {
    .qp-live-dot::after { animation: none; }
  }

  /* ---------------------------------------------------------------
     The card itself — bigger padding on hero, animated accent rim,
     hover lift, and a subtle "primed" glow when both fields are
     filled (data-ready=true is set by the script).
     --------------------------------------------------------------- */
  .qp-card {
    position: relative;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-smoke);
    padding: 20px;
    transition:
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 360ms var(--ease-out),
      border-color 360ms var(--ease-out);
    box-shadow:
      0 8px 24px -10px rgba(26, 26, 26, 0.10),
      0 2px 6px -2px rgba(26, 26, 26, 0.06);
  }
  .qp-card--hero {
    padding: 22px;
    box-shadow:
      0 24px 56px -22px rgba(26, 26, 26, 0.18),
      0 8px 22px -10px rgba(26, 26, 26, 0.08),
      0 0 0 1px color-mix(in oklab, var(--color-accent) 0%, transparent);
  }
  @media (min-width: 768px) {
    .qp-card--hero { padding: 28px; }
  }
  @media (min-width: 1024px) {
    .qp-card--hero { padding: 32px; }
  }
  .qp-card--compact { padding: 18px; }
  @media (min-width: 768px) {
    .qp-card--compact { padding: 22px; }
  }
  .qp-card.is-lifted {
    transform: translateY(-4px);
  }
  .qp-card[data-ready="true"] {
    box-shadow:
      0 28px 64px -22px color-mix(in oklab, var(--color-accent) 28%, rgba(26,26,26,0.18)),
      0 8px 22px -10px rgba(26, 26, 26, 0.10),
      0 0 0 1px color-mix(in oklab, var(--color-accent) 30%, transparent);
  }

  /* Animated accent rim — a conic-gradient that rotates slowly around
     the card. Sits behind the card via z-index trickery; user sees a
     faint moving glow at the edge. Hero variant only. */
  .qp-rim {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    z-index: -1;
    background: conic-gradient(
      from 0deg,
      color-mix(in oklab, var(--color-accent) 0%, transparent) 0deg,
      color-mix(in oklab, var(--color-accent) 0%, transparent) 200deg,
      color-mix(in oklab, var(--color-accent) 60%, transparent) 280deg,
      color-mix(in oklab, var(--color-accent) 0%, transparent) 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0.7;
    animation: qp-rim-rotate 6s linear infinite;
    pointer-events: none;
  }
  @keyframes qp-rim-rotate {
    to { transform: rotate(1turn); }
  }
  @media (prefers-reduced-motion: reduce) {
    .qp-rim { animation: none; opacity: 0.35; }
  }

  /* Connector between the two LocationPickers — dashed line + arrow dot */
  .qp-connector {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 20px;
    padding: 0 20px;
    color: var(--color-graphite);
    opacity: 0.75;
  }
  .qp-connector-line {
    flex: 1;
    height: 1px;
    background-image: linear-gradient(to right, var(--color-smoke) 50%, transparent 50%);
    background-size: 6px 1px;
    background-repeat: repeat-x;
  }
  .qp-connector-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    width: 22px;
    border-radius: 999px;
    background: var(--color-cream);
    border: 1px solid var(--color-smoke);
    color: var(--color-accent);
  }

  /* ---------------------------------------------------------------
     Price block — accent gradient backdrop when ready, halo glow
     behind the number, brief flash when a new price lands.
     --------------------------------------------------------------- */
  .qp-price-block {
    position: relative;
    margin-top: 6px;
    padding: 14px 16px 16px;
    border-radius: 14px;
    background: color-mix(in oklab, var(--color-cream) 55%, var(--color-paper));
    border: 1px solid color-mix(in oklab, var(--color-smoke) 70%, transparent);
    transition:
      background-color 360ms var(--ease-out),
      border-color 360ms var(--ease-out);
    overflow: hidden;
  }
  .qp-price-block::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 100%, var(--color-accent-glow) 0%, transparent 65%);
    opacity: 0;
    transition: opacity 480ms var(--ease-out);
    pointer-events: none;
  }
  .qp-card[data-ready="true"] .qp-price-block::before {
    opacity: 1;
  }
  .qp-price-meta {
    position: relative;
    z-index: 1;
    margin-bottom: 4px;
  }
  .qp-price-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-graphite);
  }
  .qp-price {
    position: relative;
    z-index: 1;
  }
  .qp-card[data-ready="true"] .qp-price {
    animation: qp-price-pop 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes qp-price-pop {
    0%   { transform: scale(0.94); }
    60%  { transform: scale(1.04); }
    100% { transform: scale(1); }
  }
  /* Idle state — teaser is dimmer than the real reveal */
  .qp-card:not([data-ready="true"]) .qp-price {
    color: color-mix(in oklab, var(--color-ink) 65%, transparent);
  }

  /* ---------------------------------------------------------------
     CTA — pulsing accent ring once data-ready=true. The ring sits
     behind the button via z-index, expanding + fading every 2s to
     pull the eye toward the conversion target.
     --------------------------------------------------------------- */
  .qp-cta {
    position: relative;
    overflow: visible;
  }
  .qp-cta-pulse {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
  }
  .qp-card[data-ready="true"] .qp-cta-pulse {
    animation: qp-cta-pulse 2s ease-out infinite;
  }
  @keyframes qp-cta-pulse {
    0%   { opacity: 0.7; transform: scale(1);     box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-accent) 60%, transparent); }
    70%  { opacity: 0;   transform: scale(1.06); box-shadow: 0 0 0 14px color-mix(in oklab, var(--color-accent) 0%, transparent); }
    100% { opacity: 0;   transform: scale(1.06); box-shadow: 0 0 0 14px color-mix(in oklab, var(--color-accent) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .qp-cta-pulse { animation: none !important; }
  }
  .qp-cta-arrow {
    transition: transform 280ms var(--ease-out);
  }
  .qp-card[data-ready="true"] .qp-cta-arrow {
    animation: qp-arrow-drift 1.6s ease-in-out infinite;
  }
  @keyframes qp-arrow-drift {
    0%, 100% { transform: translateX(0); }
    50%      { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .qp-cta-arrow { animation: none !important; }
  }

  /* Reassurance microcopy beneath the CTA — small green tick + line */
  .qp-reassure {
    margin: 4px 0 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.3;
    color: var(--color-graphite);
    align-self: center;
  }
  .qp-reassure-icon {
    width: 14px;
    height: 14px;
    color: var(--color-success, #1B9F4A);
    flex-shrink: 0;
  }
</style>

<script>
  // Progressive enhancement for the quote picker:
  //  - live price updates
  //  - disabled duplicate point in drop-off
  //  - price count-up animation
  //  - on submit: scroll to #booking-form and broadcast selection
  // Without JS: form still GET-submits to #booking-form with pickup/dropoff params.

  // Per-pax pricing. The hero picker always shows the 1–3 pax starting price
  // (`p1to3`) — it doesn't ask for a passenger count. The real full quote is
  // computed in BookingForm once pax is entered.
  type PriceCell = {
    p1to3?: number; p4?: number; p5?: number; p6?: number; p7?: number;
    p8?: number; p12?: number; p16?: number; p20?: number; p24?: number;
  };
  type PriceMatrix = Record<string, Record<string, PriceCell>>;
  type Labels = { from: string; empty: string; unavailable: string };

  function initPicker(form: HTMLFormElement) {
    const id = form.dataset.pickerId;
    const dataEl = document.querySelector<HTMLScriptElement>(
      `script[data-picker-data="${id}"]`,
    );
    if (!dataEl?.textContent) return;

    const { prices, labels } = JSON.parse(dataEl.textContent) as {
      prices: PriceMatrix;
      labels: Labels;
    };

    const pickup = form.querySelector<HTMLSelectElement>('[data-role="pickup"]')!;
    const dropoff = form.querySelector<HTMLSelectElement>('[data-role="dropoff"]')!;
    const priceEl = form.querySelector<HTMLElement>('[data-role="price-display"]')!;
    const labelEl = form.querySelector<HTMLElement>('[data-role="price-label"]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-role="submit"]')!;

    let currentPrice = 0;
    let wasPriced = false;
    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

    function liftCard() {
      if (reduceMotion) return;
      form.classList.add('is-lifted');
      setTimeout(() => form.classList.remove('is-lifted'), 600);
    }

    function refreshDropoffOptions() {
      const from = pickup.value;
      for (const opt of Array.from(dropoff.options)) {
        if (!opt.value) continue;
        opt.disabled = opt.value === from;
      }
      if (dropoff.value && dropoff.value === from) dropoff.value = '';
    }

    function animatePrice(to: number) {
      const from = currentPrice;
      if (from === to) {
        priceEl.textContent = `€${to}`;
        return;
      }
      const duration = 400;
      const start = performance.now();
      function step(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
        const v = Math.round(from + (to - from) * eased);
        priceEl.textContent = `€${v}`;
        if (t < 1) requestAnimationFrame(step);
        else currentPrice = to;
      }
      requestAnimationFrame(step);
    }

    function setFilled() {
      pickup.dataset.filled = pickup.value ? 'true' : 'false';
      dropoff.dataset.filled = dropoff.value ? 'true' : 'false';
    }

    // Idle baseline — preserve the SSR-rendered teaser price + label so we
    // can restore them when the user clears a selection. The template
    // pre-renders these (e.g. "Trajets dès" + "€45") so the card never
    // shows an empty "—" on first paint.
    const idlePriceText = priceEl.textContent || '';
    const idleLabelText = labelEl.textContent || '';

    function setReady(ready: boolean) {
      // Drives the accent rim brightness, price glow, CTA pulse — all CSS.
      form.dataset.ready = ready ? 'true' : 'false';
    }

    function update() {
      refreshDropoffOptions();
      setFilled();
      const from = pickup.value;
      const to = dropoff.value;

      if (!from || !to) {
        // Idle state — show the teaser, not "—". Anchors expectations.
        priceEl.textContent = idlePriceText;
        labelEl.textContent = idleLabelText;
        submit.setAttribute('aria-disabled', 'true');
        submit.disabled = true;
        setReady(false);
        currentPrice = 0;
        wasPriced = false;
        return;
      }

      const cell = prices[from]?.[to];
      // "From €X" = the 1–3 pax price. If that's missing (shouldn't happen
      // in normal data), fall back through 4-pax, 5-pax, etc.
      const startingPrice =
        typeof cell?.p1to3 === 'number' ? cell.p1to3
        : typeof cell?.p4 === 'number' ? cell.p4
        : typeof cell?.p5 === 'number' ? cell.p5
        : null;

      if (startingPrice === null) {
        priceEl.textContent = '—';
        labelEl.textContent = labels.unavailable;
        submit.setAttribute('aria-disabled', 'true');
        submit.disabled = true;
        setReady(false);
        currentPrice = 0;
        wasPriced = false;
        return;
      }

      labelEl.textContent = labels.from;
      submit.setAttribute('aria-disabled', 'false');
      submit.disabled = false;
      setReady(true);

      if (reduceMotion) {
        priceEl.textContent = `€${startingPrice}`;
        currentPrice = startingPrice;
      } else {
        animatePrice(startingPrice);
      }

      // Card lifts once, the first moment a real price lands.
      if (!wasPriced) liftCard();
      wasPriced = true;
    }

    pickup.addEventListener('change', update);
    dropoff.addEventListener('change', update);

    form.addEventListener('submit', (e) => {
      if (submit.disabled) {
        e.preventDefault();
        return;
      }
      const detail = { source: 'hero-picker', pickup: pickup.value, dropoff: dropoff.value };

      // Same-page case: a BookingModal is listening; open it + prefill via
      // the event detail. We deliberately DO NOT write the selection into
      // the URL — keeping ?pickup/?dropoff out of the address bar means a
      // refresh doesn't replay the modal or repopulate stale data.
      const modalHere = document.querySelector('[data-booking-modal]');
      if (modalHere) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('thedriver:open-booking', { detail }));
        return;
      }

      // Cross-page (e.g. on the Tarifs page): broadcast the selection, then let
      // the form GET-submit naturally so the destination page auto-opens the modal.
      window.dispatchEvent(new CustomEvent('thedriver:quote-selected', { detail }));
    });

    // Prefill from URL (if user lands directly on /?pickup=CDG&dropoff=Paris)
    const params = new URLSearchParams(window.location.search);
    if (params.get('pickup')) pickup.value = params.get('pickup') ?? '';
    if (params.get('dropoff')) dropoff.value = params.get('dropoff') ?? '';
    update();
  }

  function run() {
    document.querySelectorAll<HTMLFormElement>('[data-quote-picker]').forEach(initPicker);
  }
  // Re-run after ClientRouter navigations (astro:page-load fires on first load too).
  document.addEventListener('astro:page-load', run);
</script>
