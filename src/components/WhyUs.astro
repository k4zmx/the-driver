---
import { t } from '../i18n';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const s = t(locale).whyUs;

const items = [
  { key: 'fixedPrice', content: s.cards.fixedPrice,
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>` },
  { key: 'greet', content: s.cards.greet,
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/>` },
  { key: 'contact', content: s.cards.contact,
    icon: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>` },
  { key: 'children', content: s.cards.children,
    icon: `<path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/>` },
];
---

<section class="whyus section-y" aria-labelledby="whyus-heading">
  <div class="whyus-top-accent" aria-hidden="true"></div>

  <div class="page-x mx-auto max-w-[1200px]">
    <header class="max-w-[640px]" data-reveal>
      <p class="whyus-eyebrow">{s.eyebrow}</p>
      <h2 id="whyus-heading" class="h2 text-balance whyus-heading">{s.heading}</h2>
      {s.subheading && <p class="whyus-sub mt-3">{s.subheading}</p>}
    </header>

    <ul class="whyus-grid mt-12 md:mt-16">
      {items.map((item, i) => (
        <li class="whyus-card" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <details class="whyus-details" open>
            <summary class="whyus-summary">
              <span class="whyus-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="whyus-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              </span>
              <h3 class="whyus-title">{item.content.title}</h3>
              <span class="whyus-chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </span>
            </summary>
            <div class="whyus-content">
              <p class="whyus-body">{item.content.body}</p>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .whyus {
    position: relative;
    background: var(--color-night);
    color: var(--color-cream);
    isolation: isolate;
    overflow: hidden;
  }
  .whyus::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 15% 0%, color-mix(in oklab, var(--color-accent) 12%, transparent) 0%, transparent 55%),
      radial-gradient(ellipse at 85% 100%, color-mix(in oklab, var(--color-accent) 8%, transparent) 0%, transparent 55%);
    pointer-events: none;
    z-index: 0;
  }
  .whyus > * { position: relative; z-index: 1; }

  .whyus-top-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, color-mix(in oklab, var(--color-accent) 45%, transparent), transparent);
    z-index: 2;
  }

  .whyus-eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 14px;
  }
  .whyus-heading { color: var(--color-cream); }
  .whyus-sub {
    font-size: 17px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-cream) 68%, transparent);
  }
  @media (max-width: 767px) {
    .whyus-sub { font-size: 16px; line-height: 1.55; }
  }

  .whyus-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 640px) {
    .whyus-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
  }
  @media (min-width: 1024px) {
    .whyus-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; }
  }

  .whyus-card {
    position: relative;
    padding: 20px 22px 20px;
    border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--color-cream) 5%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-cream) 10%, transparent);
    transition: background-color 260ms var(--ease-out), border-color 260ms var(--ease-out), transform 260ms var(--ease-out);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .whyus-card { padding: 24px 22px 22px; }
  }
  @media (hover: hover) {
    .whyus-card:hover {
      background: color-mix(in oklab, var(--color-cream) 8%, transparent);
      border-color: color-mix(in oklab, var(--color-accent) 28%, transparent);
    }
  }

  /* Collapsible primitive — native <details>, smooth via ::details-content when supported */
  .whyus-details summary::-webkit-details-marker { display: none; }
  .whyus-details summary::marker { content: ''; }

  .whyus-summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-areas:
      "num icon chev"
      "title title title";
    grid-template-columns: auto 1fr auto;
    column-gap: 14px;
    row-gap: 14px;
    align-items: center;
  }
  .whyus-summary:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--color-accent) 45%, transparent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  .whyus-num {
    grid-area: num;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--color-accent) 85%, transparent);
  }
  .whyus-icon {
    grid-area: icon;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--color-accent) 18%, transparent);
    color: var(--color-accent);
  }
  .whyus-icon svg { width: 20px; height: 20px; }
  .whyus-chev {
    grid-area: chev;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-cream) 8%, transparent);
    color: color-mix(in oklab, var(--color-cream) 70%, transparent);
    transition: transform 220ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  .whyus-chev svg { width: 14px; height: 14px; }
  .whyus-details[open] .whyus-chev {
    transform: rotate(180deg);
    background: color-mix(in oklab, var(--color-accent) 18%, transparent);
    color: var(--color-accent);
  }
  .whyus-title {
    grid-area: title;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--color-cream);
    margin: 0;
  }
  @media (min-width: 768px) {
    .whyus-title { font-size: 21px; }
  }

  .whyus-content {
    padding-top: 12px;
  }
  .whyus-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-cream) 72%, transparent);
  }

  /* ---------------------------------------------------------------
     Desktop: no toggle. Content always visible, chevron gone, summary
     non-interactive. Mobile retains the <details> accordion behaviour.
     --------------------------------------------------------------- */
  @media (min-width: 768px) {
    .whyus-details > *:not(summary) {
      display: block !important;
    }
    .whyus-summary {
      cursor: default;
      pointer-events: none;
      grid-template-areas: "num icon" "title title";
      grid-template-columns: auto 1fr;
    }
    .whyus-chev { display: none !important; }
  }
</style>
