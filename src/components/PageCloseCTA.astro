---
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  sub?: string;
  primaryLabel: string;
  /** Where the primary CTA should go when no booking-modal is on the page (cross-page nav). Defaults to home root. */
  primaryFallbackHref?: string;
  secondaryLabel: string;
  secondaryHref: string;
  footnote?: string;
}

const {
  eyebrow,
  heading,
  sub,
  primaryLabel,
  primaryFallbackHref = '/#booking-form',
  secondaryLabel,
  secondaryHref,
  footnote,
} = Astro.props;

const headingWords: string[] = heading.split(/\s+/).filter(Boolean);
---

<section class="pcta section-y" aria-labelledby="pcta-heading">
  <div class="pcta-top-accent" aria-hidden="true"></div>

  <div class="pcta-bg" aria-hidden="true">
    <div class="pcta-glow"></div>
    <div class="pcta-grid"></div>
  </div>

  <div class="pcta-inner page-x mx-auto max-w-[720px] text-center">
    {eyebrow && <p class="pcta-eyebrow" data-reveal>{eyebrow}</p>}

    <h2 id="pcta-heading" class="pcta-heading" data-reveal-words>
      {headingWords.map((word, i) => (
        <>
          <span data-reveal-word style={`--i: ${i}`}>{word}</span>
          {i < headingWords.length - 1 ? ' ' : ''}
        </>
      ))}
    </h2>

    {sub && <p class="pcta-sub" data-reveal data-reveal-delay="2">{sub}</p>}

    <div class="pcta-actions" data-reveal data-reveal-delay="3">
      <button
        type="button"
        class="pcta-primary"
        data-open-booking
        data-fallback-href={primaryFallbackHref}
        data-press
      >
        <span class="pcta-primary-label">{primaryLabel}</span>
        <Icon name="arrow-right" size={16} strokeWidth={2} />
      </button>
      <a
        href={secondaryHref}
        target="_blank"
        rel="noopener noreferrer"
        class="pcta-secondary"
        data-press
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="pcta-secondary-icon">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>{secondaryLabel}</span>
      </a>
    </div>

    {footnote && <p class="pcta-footnote" data-reveal data-reveal-delay="4">{footnote}</p>}
  </div>
</section>

<style>
  /* Shared night-close composition — used by Fleet + Tarifs page closings.
     Recipe mirrors the home FinalCTA (glow + masked dot grid + shimmer primary). */
  .pcta {
    position: relative;
    background: var(--color-night);
    color: var(--color-cream);
    isolation: isolate;
    overflow: hidden;
  }
  .pcta-top-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(
      to right, transparent,
      color-mix(in oklab, var(--color-accent) 50%, transparent),
      transparent
    );
    z-index: 2;
  }
  .pcta-bg {
    position: absolute; inset: 0; pointer-events: none; z-index: 0;
  }
  .pcta-glow {
    position: absolute;
    top: 50%; left: 50%;
    width: 1000px; height: 1000px;
    margin: -500px 0 0 -500px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-accent) 28%, transparent) 0%,
      transparent 55%
    );
    filter: blur(80px);
    opacity: 0.75;
  }
  .pcta-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in oklab, var(--color-cream) 10%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--color-cream) 10%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 10%, transparent 65%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 10%, transparent 65%);
    opacity: 0.55;
  }
  @media (max-width: 767px) {
    .pcta-glow { width: 640px; height: 640px; margin: -320px 0 0 -320px; filter: blur(60px); }
    .pcta-grid { background-size: 44px 44px; }
  }

  .pcta-inner { position: relative; z-index: 1; }

  .pcta-eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 18px;
  }
  .pcta-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-cream);
  }
  @media (min-width: 768px) {
    .pcta-heading { font-size: 52px; }
  }
  @media (min-width: 1024px) {
    .pcta-heading { font-size: 60px; }
  }
  .pcta-sub {
    margin: 20px auto 0;
    max-width: 48ch;
    font-size: 17px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-cream) 72%, transparent);
  }
  @media (max-width: 767px) {
    .pcta-sub { font-size: 16px; line-height: 1.55; }
  }

  .pcta-actions {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
    align-items: center;
  }
  @media (min-width: 640px) {
    .pcta-actions { flex-direction: row; gap: 14px; }
  }
  @media (min-width: 768px) {
    .pcta-actions { margin-top: 40px; }
  }

  .pcta-primary {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    padding: 0 28px;
    width: 100%;
    border: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    box-shadow:
      0 18px 40px -12px color-mix(in oklab, var(--color-accent) 60%, transparent),
      0 0 0 1px color-mix(in oklab, white 10%, transparent) inset;
    transition:
      background-color 220ms var(--ease-out),
      box-shadow 260ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  @media (min-width: 640px) {
    .pcta-primary { width: auto; min-width: 240px; }
  }
  .pcta-primary:hover {
    background: var(--color-accent-ink);
    box-shadow:
      0 22px 48px -12px color-mix(in oklab, var(--color-accent) 70%, transparent),
      0 0 0 1px color-mix(in oklab, white 16%, transparent) inset;
  }
  .pcta-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg, transparent 30%,
      color-mix(in oklab, white 40%, transparent) 50%, transparent 70%
    );
    transform: translateX(-120%);
    transition: transform 900ms var(--ease-out);
    pointer-events: none;
  }
  .pcta-primary:hover::after { transform: translateX(120%); }
  .pcta-primary-label { position: relative; z-index: 1; }
  .pcta-primary svg { position: relative; z-index: 1; }

  .pcta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    padding: 0 28px;
    width: 100%;
    border-radius: 999px;
    background: transparent;
    color: var(--color-cream);
    border: 1.5px solid color-mix(in oklab, var(--color-cream) 30%, transparent);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    transition:
      background-color 220ms var(--ease-out),
      color 220ms var(--ease-out),
      border-color 220ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  @media (min-width: 640px) {
    .pcta-secondary { width: auto; }
  }
  .pcta-secondary:hover {
    background: var(--color-cream);
    color: var(--color-ink);
    border-color: var(--color-cream);
  }
  .pcta-secondary-icon {
    width: 18px; height: 18px; flex-shrink: 0;
  }

  .pcta-footnote {
    margin: 26px auto 0;
    max-width: 52ch;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
  }
</style>

<script>
  // Primary button — opens the booking modal via global event hook.
  // On pages without a modal (Fleet, Tarifs, FAQ+Contact), falls back to hash navigation home.
  function run() {
    document.querySelectorAll<HTMLButtonElement>('[data-open-booking]').forEach((btn) => {
      if (btn.dataset.wired === 'true') return;
      btn.dataset.wired = 'true';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        if (document.querySelector('[data-booking-modal]')) {
          window.dispatchEvent(
            new CustomEvent('thedriver:open-booking', {
              detail: { source: 'page-close-cta' },
            }),
          );
        } else {
          const fallback = btn.dataset.fallbackHref || '/#booking-form';
          location.assign(fallback);
        }
      });
    });
  }
  document.addEventListener('astro:page-load', run);
</script>
