---
import { t } from '../i18n';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const s = t(locale).howItWorks;
const steps: { title: string; body: string }[] = s.steps;
---

{/*
  Reworked HowItWorks — no sticky scroll-jacking, no JS coupling.
  Mobile (<768px): 1-column stack.
  Tablet  (≥768):  2-column grid.
  Desktop (≥1024): 4-column grid, each card with a big background numeral
                   that always reads (no scroll-driven crossfade).
  Reveal: existing reveal.js applies opacity/translate via [data-reveal];
          per-card stagger comes from a transition-delay tied to --i.
*/}
<section class="hiw" aria-labelledby="hiw-heading">
  <div class="page-x mx-auto max-w-[1200px] hiw-header">
    <header class="max-w-[640px]" data-reveal>
      <p class="meta-label mb-3">{s.eyebrow}</p>
      <h2 id="hiw-heading" class="h2 text-balance">{s.heading}</h2>
    </header>
  </div>

  <div class="page-x mx-auto max-w-[1200px]">
    <ol class="hiw-steps">
      {steps.map((step, i) => (
        <li class="hiw-step" data-reveal style={`--i: ${i}`}>
          <span class="hiw-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="hiw-step-body">
            <span class="hiw-step-eyebrow">
              <span class="hiw-step-marker" aria-hidden="true"></span>
              {s.eyebrow}
            </span>
            <h3 class="hiw-step-title">{step.title}</h3>
            <p class="hiw-step-text">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hiw {
    background: var(--color-cream);
    position: relative;
    overflow: hidden;
    padding-top: clamp(60px, 9vw, 110px);
    padding-bottom: clamp(60px, 9vw, 110px);
  }
  .hiw-header {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  /* ── Steps grid ── */
  .hiw-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .hiw-steps { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .hiw-steps { grid-template-columns: repeat(4, 1fr); gap: 20px; }
  }

  /* ── Card ── */
  .hiw-step {
    position: relative;
    padding: 32px 28px 30px;
    border-radius: var(--radius-card, 14px);
    background: var(--color-paper);
    border: 1px solid var(--color-smoke);
    box-shadow: 0 12px 32px -20px rgba(26, 26, 26, 0.18);
    overflow: hidden;
    transition:
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 360ms var(--ease-out),
      border-color 360ms var(--ease-out);
  }
  .hiw-step:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 60px -22px rgba(26, 26, 26, 0.24);
    border-color: color-mix(in oklab, var(--color-accent) 35%, var(--color-smoke));
  }
  .hiw-step:hover .hiw-step-num {
    color: color-mix(in oklab, var(--color-accent) 18%, transparent);
    transform: translate(0, -4px);
  }

  /* Big background numeral — always visible (no scroll crossfade), sits
     behind the content. Pinned top-right, slightly oversized so it reads
     as a poster numeral without crowding the title. */
  .hiw-step-num {
    position: absolute;
    top: -14px;
    right: -10px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(110px, 13vw, 170px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: color-mix(in oklab, var(--color-accent) 9%, transparent);
    pointer-events: none;
    z-index: 0;
    transition: color 360ms var(--ease-out), transform 360ms var(--ease-out);
  }

  .hiw-step-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 200px;
  }

  .hiw-step-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-graphite);
  }
  .hiw-step-marker {
    width: 14px;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .hiw-step-title {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .hiw-step-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-graphite);
  }

  @media (min-width: 768px) {
    .hiw-step-title { font-size: 24px; }
    .hiw-step-text  { font-size: 15px; }
  }
  @media (min-width: 1280px) {
    .hiw-step-title { font-size: 22px; }
  }

  /* ── Reveal stagger — global [data-reveal] in global.css already
     handles the opacity/translate; we just sequence them via --i. ── */
  .hiw-step[data-reveal] {
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-step,
    .hiw-step:hover,
    .hiw-step .hiw-step-num,
    .hiw-step:hover .hiw-step-num {
      transition: none;
      transform: none;
    }
  }
</style>
