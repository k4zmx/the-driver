---
import { t } from '../i18n';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const s = t(locale).howItWorks;
const steps: { title: string; body: string }[] = s.steps;
---

{/*
  Mobile (<768px): horizontal scroll-snap carousel — touch-swipe friendly.
  Tablet  (≥768): 2-column static grid.
  Desktop (≥1024): 4-column static grid (the "give up the scroll" path).
  No JS, no scroll-jacking.
*/}
<section class="hiw" aria-labelledby="hiw-heading">
  <div class="page-x mx-auto max-w-[1200px] hiw-header">
    <header class="max-w-[640px]" data-reveal>
      <p class="meta-label mb-3">{s.eyebrow}</p>
      <h2 id="hiw-heading" class="h2 text-balance">{s.heading}</h2>
    </header>
  </div>

  <div class="page-x mx-auto max-w-[1200px] hiw-shell">
    <ol class="hiw-steps">
      {steps.map((step, i) => (
        <li class="hiw-step" data-reveal style={`--i: ${i}`}>
          <span class="hiw-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="hiw-step-body">
            <span class="hiw-step-eyebrow">
              <span class="hiw-step-marker" aria-hidden="true"></span>
              {s.eyebrow}
            </span>
            <h3 class="hiw-step-title">{step.title}</h3>
            <p class="hiw-step-text">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hiw {
    background: var(--color-cream);
    position: relative;
    overflow: hidden;
    padding-top: clamp(60px, 9vw, 110px);
    padding-bottom: clamp(60px, 9vw, 110px);
  }
  .hiw-header {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  /* ── Mobile carousel ─────────────────────────────────────────────
     Phones get a horizontal scroll-snap carousel — feels right with
     swipe, no need for prev/next buttons. */
  .hiw-shell {
    /* Override page-x's side padding so the track can be full-bleed for
       proper snap behavior on phones. */
    padding-inline: 0;
    max-width: none;
  }
  .hiw-steps {
    list-style: none;
    margin: 0;
    padding: 8px 24px 32px;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .hiw-steps::-webkit-scrollbar { display: none; }

  .hiw-step {
    flex: 0 0 calc(100% - 48px);
    max-width: 360px;
    scroll-snap-align: center;

    position: relative;
    padding: 32px 28px 30px;
    border-radius: var(--radius-card, 14px);
    background: var(--color-paper);
    border: 1px solid var(--color-smoke);
    box-shadow: 0 12px 32px -20px rgba(26, 26, 26, 0.18);
    overflow: hidden;
    transition:
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 360ms var(--ease-out),
      border-color 360ms var(--ease-out);
  }

  /* ── Tablet + desktop: static grid, no scroll ──────────────────── */
  @media (min-width: 768px) {
    .hiw-shell {
      padding-inline: var(--page-x, 24px);
      max-width: 1200px;
      margin-inline: auto;
    }
    .hiw-steps {
      padding: 0;
      gap: 24px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      overflow: visible;
      scroll-snap-type: none;
    }
    .hiw-step {
      flex: initial;
      max-width: none;
      scroll-snap-align: none;
    }
  }
  @media (min-width: 1024px) {
    .hiw-steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .hiw-step:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 60px -22px rgba(26, 26, 26, 0.24);
    border-color: color-mix(in oklab, var(--color-accent) 35%, var(--color-smoke));
  }
  .hiw-step:hover .hiw-step-num {
    color: color-mix(in oklab, var(--color-accent) 18%, transparent);
    transform: translate(0, -4px);
  }

  /* Big background numeral — pinned top-right, always visible. */
  .hiw-step-num {
    position: absolute;
    top: -14px;
    right: -10px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(110px, 13vw, 170px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: color-mix(in oklab, var(--color-accent) 9%, transparent);
    pointer-events: none;
    z-index: 0;
    transition: color 360ms var(--ease-out), transform 360ms var(--ease-out);
  }

  .hiw-step-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 200px;
  }
  .hiw-step-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-graphite);
  }
  .hiw-step-marker {
    width: 14px;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .hiw-step-title {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .hiw-step-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-graphite);
  }
  @media (min-width: 768px) {
    .hiw-step-title { font-size: 24px; }
    .hiw-step-text  { font-size: 15px; }
  }
  @media (min-width: 1024px) {
    .hiw-step-title { font-size: 22px; }
    .hiw-step-text  { font-size: 14px; }
  }

  /* Reveal stagger via the global [data-reveal] system. */
  .hiw-step[data-reveal] {
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-step,
    .hiw-step:hover,
    .hiw-step .hiw-step-num,
    .hiw-step:hover .hiw-step-num {
      transition: none;
      transform: none;
    }
  }
</style>
