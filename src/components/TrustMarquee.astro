---
/**
 * Editorial scrolling trust strip — sits right after the hero and before
 * Why Us. Reinforces brand signals while adding ambient horizontal motion
 * to break up the otherwise vertical, static layout.
 *
 * Pure CSS animation: a flex track translates from 0 → -50%, and the
 * inner content is duplicated so the loop is seamless. Pauses on hover
 * (desktop) and on `prefers-reduced-motion`.
 */
import { t } from '../i18n';

interface Props {
  locale: 'fr' | 'en' | 'es' | 'it';
}

const { locale } = Astro.props;
const hero = t(locale).hero;

const extraByLocale: Record<string, string[]> = {
  fr: ['Suivi de vol', 'Anglais parlé', 'Aucun acompte', '24h/24, 7j/7'],
  en: ['Flight tracking', 'English spoken', 'No deposit', '24/7'],
  es: ['Seguimiento de vuelo', 'Inglés hablado', 'Sin depósito', '24/7'],
  it: ['Monitoraggio volo', 'Inglese parlato', 'Nessun acconto', '24/7'],
};

const items: string[] = [
  hero.trust.rating,
  hero.trust.childseats,
  hero.trust.license,
  hero.trust.payment,
  ...(extraByLocale[locale] ?? []),
];

// Star glyph for the rating chip — picked out so the visual "weight" of
// the item matches the rest of the line.
function isRatingItem(text: string) {
  return /google/i.test(text);
}
---

<section class="tm" aria-label="Trust signals" data-trust-marquee>
  <div class="tm-track">
    {[0, 1].map((groupIndex) => (
      <div class="tm-group" aria-hidden={groupIndex === 1 ? 'true' : 'false'}>
        {items.map((item) => (
          <span class="tm-item">
            {isRatingItem(item) ? (
              <svg class="tm-icon is-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ) : (
              <span class="tm-dot" aria-hidden="true"></span>
            )}
            <span class="tm-label">{item}</span>
          </span>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .tm {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-paper);
    border-top: 1px solid var(--color-smoke);
    border-bottom: 1px solid var(--color-smoke);
    padding: 14px 0;
    /* Edge fades so items melt in/out at the viewport edges. */
    mask-image: linear-gradient(to right,
      transparent 0,
      black 48px,
      black calc(100% - 48px),
      transparent 100%);
    -webkit-mask-image: linear-gradient(to right,
      transparent 0,
      black 48px,
      black calc(100% - 48px),
      transparent 100%);
  }

  .tm-track {
    display: flex;
    width: max-content;
    gap: 0;
    animation: tm-scroll 42s linear infinite;
    will-change: transform;
  }
  .tm-group {
    display: inline-flex;
    align-items: center;
    gap: 36px;
    padding-right: 36px;
    flex-shrink: 0;
  }
  @keyframes tm-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  /* Pause on hover (desktop only — mobile lacks meaningful hover) */
  @media (hover: hover) and (pointer: fine) {
    .tm:hover .tm-track { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tm-track { animation: none; transform: none; }
    .tm { mask-image: none; -webkit-mask-image: none; }
  }

  .tm-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-graphite);
    white-space: nowrap;
  }
  .tm-label { color: var(--color-ink); font-weight: 500; }
  .tm-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-accent);
    opacity: 0.55;
  }
  .tm-icon {
    width: 14px;
    height: 14px;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .tm-icon.is-star { color: #FBBC04; }

  @media (min-width: 768px) {
    .tm { padding: 16px 0; }
    .tm-group { gap: 48px; padding-right: 48px; }
    .tm-item { font-size: 14px; }
  }
</style>
