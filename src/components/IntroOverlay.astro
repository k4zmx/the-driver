---
/**
 * Welcome wave intro overlay — plays once per session, on the home page only.
 *
 * Sequence (1.8s total — 25% faster than the previous 2.4s pacing):
 *   0     →  600ms   4 horizontal color bands stagger in from the right —
 *                    deepest terracotta on top → dusty cream at bottom,
 *                    ~113ms stagger top-to-bottom
 *   600   → 1275ms   Hold; cream arrow draws across upper darker band,
 *                    BIENVENUE + "Bienvenue à Paris" subline fade in
 *   600ms           BaseLayout's `intro-pending` class is removed — page
 *                    content paints behind the (still-covering) bands,
 *                    so it's ready when the bands slide off
 *   1275  → 1800ms   Bands stagger out — bottom (cream) first, top last
 *   1900ms          Cleanup: overlay removed from DOM
 *
 * Visual: warm tonal sunset poster — 4 stacked horizontal color bands
 * tracking the brand palette (deep terracotta → terracotta → warm rose →
 * dusty cream). Each band's curvy bottom edge laps over the band below
 * for a hand-cut paper-collage feel. Bands overlap heavily so the next
 * band's flat top always sits beneath the previous band's highest crest
 * — no gaps, hero content never visible during the intro.
 *
 * Skipped when:
 *   - sessionStorage flag exists (set by inline head script in BaseLayout
 *     pre-paint, no flash on returning visitors)
 *   - prefers-reduced-motion is reduce
 *   - mobile in landscape orientation
 *
 * Performance: pure CSS keyframes, transform/opacity/stroke-dashoffset
 * only. 4 SVG bands + arrow + 2 text elements = 7 GPU layers.
 */
---

<div class="intro-overlay" data-intro aria-hidden="true">
  {/* Four horizontal color bands. Each is a full-viewport-wide SVG with
      viewBox 0 0 100 30 stretched to fill its 30%-tall container. Path
      tops are flat (flush against the band above's wavy bottom); path
      bottoms are wavy curves that lap over the band below. */}

  <svg class="intro-band intro-band--b1" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
    {/* Band 1 (deep terracotta, top): bold single dip slightly off-center */}
    <path d="M 0 0 L 100 0 L 100 22 C 90 22, 76 30, 58 30 C 40 30, 24 22, 0 22 Z" />
  </svg>

  <svg class="intro-band intro-band--b2" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
    {/* Band 2 (terracotta brand): double crest, more aggressive waves */}
    <path d="M 0 0 L 100 0 L 100 24 C 80 30, 65 22, 50 26 C 35 30, 20 22, 0 26 Z" />
  </svg>

  <svg class="intro-band intro-band--b3" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
    {/* Band 3 (warm rose): gentle continuous wave, broader and calmer */}
    <path d="M 0 0 L 100 0 L 100 25 C 70 28, 40 23, 0 25 Z" />
  </svg>

  <svg class="intro-band intro-band--b4" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
    {/* Band 4 (dusty cream, foundational base): full-rectangle fill so the
        bottom of the viewport is always covered. Band 3's wave sits on top
        of this band's flat surface — that's where the visual character at
        the band-3/band-4 boundary comes from. */}
    <path d="M 0 0 L 100 0 L 100 30 L 0 30 Z" />
  </svg>

  {/* Bolder cream arrow with arrowhead — unchanged from previous round.
      Sits over the darker top bands so the cream stroke has high contrast. */}
  <svg class="intro-arrow" viewBox="0 0 320 50" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <path
      class="intro-arrow-shaft"
      d="M 20 25 Q 100 5, 180 25 T 290 25"
      fill="none"
      stroke="#F8F5EE"
      stroke-width="4"
      stroke-linecap="round"
      pathLength="100"
      stroke-dasharray="100"
      stroke-dashoffset="100"
    />
    <polygon
      class="intro-arrow-head"
      points="298,25 282,17 282,33"
      fill="#F8F5EE"
    />
  </svg>

  <p class="intro-text">BIENVENUE</p>
  <p class="intro-subline">Bienvenue à Paris</p>
</div>

<style>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
  }
  /* Skip path — set by the inline head script in BaseLayout for: session-
     already-shown, reduced-motion, or landscape mobile. */
  :root[data-intro-skip] .intro-overlay {
    display: none !important;
  }

  /* ---------------------------------------------------------------
     Horizontal color bands — 4 stacked layers. Heights and tops are
     tuned so each band's flat top sits at-or-above the previous band's
     highest wave crest, eliminating any gap to hero content. Higher
     z-index on top bands so their wavy bottom edges sit ON TOP of the
     band below — paper-cut sunset effect.

     Math: each path's wave reaches y=22 at its highest crest in a
     viewBox 0..30. Container heights of 30% / 30% / 30% / 34% with
     tops at 0 / 22% / 44% / 66% give 8% overlap between consecutive
     bands — exactly enough so band-N+1's flat top covers band-N's
     highest crest at viewport (22/30 × 30%) = 22% inside the band.
     --------------------------------------------------------------- */
  .intro-band {
    position: absolute;
    left: 0;
    width: 100vw;
    display: block;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(100vw, 0, 0); /* off-screen baseline */
    pointer-events: none;
  }
  .intro-band--b1 { top: 0;    height: 30%; z-index: 4; animation: intro-band-b1 1800ms forwards; }
  .intro-band--b2 { top: 22%;  height: 30%; z-index: 3; animation: intro-band-b2 1800ms forwards; }
  .intro-band--b3 { top: 44%;  height: 30%; z-index: 2; animation: intro-band-b3 1800ms forwards; }
  .intro-band--b4 { top: 66%;  height: 34%; z-index: 1; animation: intro-band-b4 1800ms forwards; }

  /* Brand-tonal palette — every color is the accent or a mix of accent +
     cream / accent + black. Sets fill via CSS so we get the variable. */
  .intro-band--b1 path { fill: color-mix(in srgb, var(--color-accent) 100%, black 25%); }
  .intro-band--b2 path { fill: var(--color-accent); }
  .intro-band--b3 path { fill: color-mix(in srgb, var(--color-accent) 60%, var(--color-cream) 40%); }
  .intro-band--b4 path { fill: color-mix(in srgb, var(--color-accent) 25%, var(--color-cream) 75%); }

  /* Per-band keyframes — single shared 2400ms timeline, each band has its
     own entry hold + exit start so we get a coherent arrival moment at
     800ms and a coherent dismissal moment at 2400ms with varied
     per-band durations. Easings applied per-keyframe. */

  @keyframes intro-band-b1 {
    /* Top band — first in (0ms), last out (2150ms exit start, 250ms exit) */
    0% {
      transform: translate3d(100vw, 0, 0);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    33.33% { /* 800ms — settled */
      transform: translate3d(0, 0, 0);
      animation-timing-function: linear;
    }
    89.58% { /* 2150ms — exit begins */
      transform: translate3d(0, 0, 0);
      animation-timing-function: cubic-bezier(0.36, 0, 0.66, 0.04);
    }
    100% { transform: translate3d(100vw, 0, 0); }
  }
  @keyframes intro-band-b2 {
    /* Terracotta — second in (150ms), exits at 2000ms (400ms exit) */
    0% {
      transform: translate3d(100vw, 0, 0);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    6.25% { transform: translate3d(100vw, 0, 0); } /* held off-screen until 150ms */
    33.33% { /* 800ms — settled */
      transform: translate3d(0, 0, 0);
      animation-timing-function: linear;
    }
    83.33% { /* 2000ms — exit begins */
      transform: translate3d(0, 0, 0);
      animation-timing-function: cubic-bezier(0.36, 0, 0.66, 0.04);
    }
    100% { transform: translate3d(100vw, 0, 0); }
  }
  @keyframes intro-band-b3 {
    /* Warm rose — third in (300ms), exits at 1850ms (550ms exit) */
    0% {
      transform: translate3d(100vw, 0, 0);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    12.5% { transform: translate3d(100vw, 0, 0); } /* held until 300ms */
    33.33% { /* 800ms — settled */
      transform: translate3d(0, 0, 0);
      animation-timing-function: linear;
    }
    77.08% { /* 1850ms — exit begins */
      transform: translate3d(0, 0, 0);
      animation-timing-function: cubic-bezier(0.36, 0, 0.66, 0.04);
    }
    100% { transform: translate3d(100vw, 0, 0); }
  }
  @keyframes intro-band-b4 {
    /* Dusty cream — last in (450ms), first out (1700ms exit start, 700ms exit) */
    0% {
      transform: translate3d(100vw, 0, 0);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    18.75% { transform: translate3d(100vw, 0, 0); } /* held until 450ms */
    33.33% { /* 800ms — settled */
      transform: translate3d(0, 0, 0);
      animation-timing-function: linear;
    }
    70.83% { /* 1700ms — exit begins (first to leave) */
      transform: translate3d(0, 0, 0);
      animation-timing-function: cubic-bezier(0.36, 0, 0.66, 0.04);
    }
    100% { transform: translate3d(100vw, 0, 0); }
  }

  /* ---------------------------------------------------------------
     Cream arrow — bolder stroke, S-curve, draws across the upper
     darker bands during hold. Position shifted up so it sits over
     band 1 + band 2 (deep terracotta + terracotta) — high contrast
     for the cream stroke and the BIENVENUE text below it.
     --------------------------------------------------------------- */
  .intro-arrow {
    position: absolute;
    left: 50%;
    top: 28%;
    width: min(60vw, 220px);
    height: auto;
    transform: translate(-50%, -50%);
    z-index: 10;
    opacity: 0;
    will-change: opacity;
    animation: intro-arrow-fade 1800ms forwards;
  }
  @media (min-width: 768px) {
    .intro-arrow {
      width: min(50vw, 320px);
      top: 26%;
    }
  }
  .intro-arrow-shaft {
    will-change: stroke-dashoffset;
    animation: intro-arrow-draw 450ms 600ms cubic-bezier(0.65, 0.05, 0.36, 1) forwards;
  }
  .intro-arrow-head {
    opacity: 0;
    transform: scale(0.6);
    transform-origin: center;
    transform-box: fill-box;
    will-change: transform, opacity;
    animation: intro-arrow-head 165ms 1050ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes intro-arrow-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes intro-arrow-head {
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes intro-arrow-fade {
    /* Hidden behind off-screen bands during entry */
    0%, 33.33% { opacity: 0; }
    35%        { opacity: 1; }
    /* 1700ms (70.83%) — bands begin exit, arrow fades with text */
    70.83%     { opacity: 1; }
    91.67%     { opacity: 0; } /* 2200ms — fully faded */
    100%       { opacity: 0; }
  }

  /* ---------------------------------------------------------------
     BIENVENUE + subline — typography unchanged, but vertical position
     shifted up so the text sits on band 2 (base terracotta — viewport
     22-52%). Cream-on-terracotta keeps high contrast; on the lighter
     bottom bands the cream text would wash out.
     --------------------------------------------------------------- */
  .intro-text {
    position: absolute;
    left: 50%;
    top: 38%;
    transform: translate3d(-50%, 8px, 0);
    margin: 0;
    font-family: var(--font-display, "Fraunces"), Georgia, serif;
    font-size: 38px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: #F8F5EE;
    z-index: 10;
    opacity: 0;
    will-change: transform, opacity;
    animation: intro-text 900ms 750ms forwards;
  }
  @media (min-width: 768px) {
    .intro-text { font-size: 64px; top: 36%; }
  }
  @keyframes intro-text {
    0% {
      opacity: 0;
      transform: translate3d(-50%, 8px, 0);
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    41.67% { /* 500ms in — settled */
      opacity: 1;
      transform: translate3d(-50%, 0, 0);
      animation-timing-function: linear;
    }
    58.33% { /* 700ms in — exit begins */
      opacity: 1;
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      opacity: 0;
      transform: translate3d(-50%, 0, 0);
    }
  }

  .intro-subline {
    position: absolute;
    left: 50%;
    top: 38%;
    transform: translate(-50%, 0);
    margin: 56px 0 0;
    font-family: var(--font-sans, "Inter"), system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(248, 245, 238, 0.75);
    z-index: 10;
    opacity: 0;
    white-space: nowrap;
    will-change: transform, opacity;
    animation: intro-subline 675ms 975ms forwards;
  }
  @media (min-width: 768px) {
    .intro-subline {
      font-size: 16px;
      top: 36%;
      margin-top: 84px;
    }
  }
  @keyframes intro-subline {
    0% {
      opacity: 0;
      transform: translate(-50%, 4px);
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    33.33% { /* 300ms in — settled */
      opacity: 0.75;
      transform: translate(-50%, 0);
    }
    44.44% { /* 400ms in — exit begins */
      opacity: 0.75;
      transform: translate(-50%, 0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 0);
    }
  }

  /* Reduced-motion + landscape mobile — fully skip */
  @media (prefers-reduced-motion: reduce) {
    .intro-overlay { display: none !important; }
  }
  @media (max-width: 767px) and (orientation: landscape) {
    .intro-overlay { display: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var overlay = document.querySelector('[data-intro]');
    if (!overlay) return;

    // Skip path — the inline head script already handled the decision.
    if (document.documentElement.getAttribute('data-intro-skip') === 'true') {
      if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
      return;
    }

    // Reveal page content once bands have fully covered the screen (600ms).
    // BaseLayout's `intro-pending` class hid <main>/<nav>/<footer> through
    // first paint; lifting it here lets the page paint behind the still-
    // covering bands so it's ready by the time bands begin their exit
    // (1275ms). No flash either way.
    setTimeout(function () {
      document.documentElement.classList.remove('intro-pending');
    }, 600);

    // Cleanup after the band exit completes. 100ms buffer past 1800ms.
    setTimeout(function () {
      if (overlay && overlay.parentNode) overlay.parentNode.removeChild(overlay);
    }, 1900);
  })();
</script>
