---
/**
 * Lucide icons inlined as SVG. Add a new one to ICONS + it's usable anywhere.
 * Stroke uses currentColor so caller tints via text color.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
  strokeWidth?: number;
  ariaLabel?: string;
}

const {
  name,
  class: className = '',
  size = 20,
  strokeWidth = 1.5,
  ariaLabel,
} = Astro.props;

const ICONS: Record<string, string> = {
